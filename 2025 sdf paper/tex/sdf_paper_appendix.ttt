\begin{table}[htbp]
\centering
\small
\begin{tabular}{@{}ll@{}}
\toprule
Symbol & Description \\
\midrule
$V$ & Number of distinct vintage years ($v = 1,\dots,V$) \\
$n_v$ & Number of funds in vintage $v$ (eligible for $U_{v,H}$ when $n_v \ge 2$) \\
$t_v^0$ & Common vintage origin date (first observed cash flow of vintage $v$; or predetermined Dec~31 of $v-1$) \\
$T_{\max}$ & Common sample end date (2021-12-31 in the main empirical grid) \\
$CF_{v,i,t}$ & Net cash flow of fund $i$ in vintage $v$ at month $t$ (per unit commitment in EW; USD~mn in FW) \\
$s_{v,i}, w_{v,i}$ & Fund size (USD~mn) and normalized within-vintage fund weight ($w_{v,i}=1/n_v$ EW; $w_{v,i}=s_{v,i}/\sum_k s_{v,k}$ FW) \\
$G_u(\theta)$ & One-period gross benchmark return $1 + r_{f,u} + \alpha + \beta^\top F_u$ \\
$M_u(\theta), \Psi_t(\theta)$ & One-period deflator $G_u(\theta)^{-1}$ and cumulative deflator $\prod_{u=1}^t M_u(\theta)$ ($\Psi_0=1$) \\
$R^b_{a,b}(\theta)$ & Cumulative gross benchmark return $\Psi_a(\theta)/\Psi_b(\theta) = \prod_{u=a+1}^b G_u(\theta)$ \\
$PV_{v,i}(\theta), PV_v(\theta)$ & Inception present value of fund $i$ and constant-composition vintage pool $PV_v = \sum_i w_{v,i} PV_{v,i}$ \\
$\mathcal{F}_t$ & Filtration generated by public returns and deal information up to date $t$ \\
$\mathcal{C}_v$ & Public factor-path and horizon-window information set for vintage $v$ \\
$\mathcal{G}_v$ & Conditioning set including $\mathcal{C}_v$, eligibility $n_v\ge 2$, fund sizes $\{s_{v,i}\}$, and origin $t_v^0$ \\
$\mu_v(\theta), c_v(\theta), \sigma_v^2(\theta)$ & Conditional mean, common within-vintage covariance, and total conditional variance of $PV_{v,i}(\theta)$ given $\mathcal{G}_v$ \\
\bottomrule
\end{tabular}
\caption{Key notation for pooled private-equity cash flows and benchmark discounting.}
\label{tab:notation_asset_pricing}
\end{table}
\efloatseparator
 
\begin{table}[htbp]
\centering
\small
\begin{tabular}{@{}ll@{}}
\toprule
Symbol & Description \\
\midrule
$H, \mathcal{T}_{v,H}$ & Compounding horizon (years) and valuation window $\{t_v^0,\dots,\min(t_v^0+12H, T_{\max})\}$ \\
$A_{v,H}(\theta)$ & Horizon-average compounding scale $|\mathcal{T}_{v,H}|^{-1}\sum_{\tau\in\mathcal{T}_{v,H}} R^b_{t_v^0,\tau}(\theta) > 0$ \\
$\bar\epsilon_{v,i,H}(\theta), \bar\epsilon_{v,H}(\theta)$ & Horizon-averaged pricing errors $A_{v,H}(\theta) PV_{v,i}(\theta)$ and $A_{v,H}(\theta) PV_v(\theta)$ \\
$Q_{V,H}^{\mathrm{L2}}(\theta), Q_H^{\mathrm{L2}}(\theta)$ & Sample and population squared pooled-NPV (L2) criteria \\
$U_{v,H}(\theta), q_v$ & Within-vintage cross-fund pair-product statistic and vintage weight ($q_v=1$ main; $q_v=n_v$ robustness) \\
$\Theta$ & Admissible parameter domain ($\beta_{\mathrm{MKT}}\in[-1,4]$, $\alpha\in[-2\%,2\%]$/mo, $\min_t G_t(\theta)\ge 0.08$) \\
$\theta_0, \theta_H^\dagger$ & Structural pricing parameter and horizon-specific population criterion minimizer \\
$S, b$ & Bartlett truncation bandwidth $S = \lceil 1.3\sqrt{V}\rceil$ (LLSW) and fixed-$b$ ratio $b = S/V$ \\
$\mathcal{H}_H, \Lambda_H, \Sigma_H$ & Population Hessian, long-run score covariance, and sandwich variance $\mathcal{H}_H^{-1}\Lambda_H\mathcal{H}_H^{-1}$ \\
$N_{\mathrm{eff}}$ & Effective number of vintages from influence-function share concentration \\
\bottomrule
\end{tabular}
\caption{Key notation for the L2, $U_{v,H}$, and IV estimators and fixed-$b$ SHAC inference.}
\label{tab:notation_estimator}
\end{table}
