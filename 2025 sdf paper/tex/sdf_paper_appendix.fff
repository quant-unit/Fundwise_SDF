\begin{figure}[htbp]
\centering
\includegraphics[width=0.85\textwidth]{figure_S3_growing_V.pdf}
\caption{Monte Carlo: more vintages with the same funds per vintage}
\label{fig:mc_growing_v}
\par\vspace{2pt}
{\scriptsize\textit{Notes:} Single-factor $\hat\beta_{MKT}$ (true value 1) at $H=0$ for $V=25$, 100 and 400 consecutive vintages ending 2005 with 5 or 20 funds each, deal model of the cores. Each replication draws its own factor path: whole months of 1967--2021 resampled i.i.d.\ on a calendar from the first vintage to 2021 (100 or 400 vintages do not fit the history). L2 on vintage portfolios with its target shift (the minimizer of the criterion averaged over replications 1--200, minus the true value); $U_{v,H}$ with $q_v=1$; IV as in Table~\ref{tab:mc_size_additions}. The L2 bias does not fall with $V$; it equals the target shift and shrinks with the funds per vintage (the noise tilt, T3/T4), and with a fixed bias and a shrinking SE its rejection rate rises with $V$. Bars: $\pm2$ Monte Carlo SE. 500 replications per design.}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
\centering
\includegraphics[width=\textwidth]{figure_S5_alpha_beta_contours.pdf}
\caption{Normalized $(\alpha,\beta)$ criterion contours for Buyout and Venture Capital (EW) at $H=0$ and $H=15$ years}
\label{fig:alpha_beta_contours}
\par\vspace{2pt}
{\scriptsize\textit{Notes:} Normalized criterion surfaces $(Q(\alpha,\beta)-Q_{\min})/(Q_{0.90}-Q_{\min})$ over $\beta\in[0,2.8]$ and $\alpha\in[-1.5\%,2\%]$ per month (darker shading = lower criterion; orange circle = constrained optimum on $\Theta$). Top/bottom rows compare Buyout EW (well-defined negatively sloped interior valley reflecting the negative $(\hat\alpha,\hat\beta)$ trade-off) with VC EW (at $H=0$ the surface falls monotonically to the $+2\%$ monthly $\alpha$ upper bound under both L2 and $U_{v,H}$, whereas $H=15$ imposes coercivity without identifying $\alpha$).}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
\centering
\includegraphics[width=0.92\textwidth]{figure_S5_vintage_residuals.pdf}
\caption{Vintage-level inception pricing errors $PV_v(\hat\beta_{U,0})$ with within-vintage $\pm1.96\,\mathrm{SE}$ bars}
\label{fig:vintage_residuals}
\par\vspace{2pt}
{\scriptsize\textit{Notes:} North America complete-history sample ($V\le 2010$). Each point is the constant-composition vintage portfolio inception NPV evaluated at the headline $U_{v,0}$ ($q_v=1$) single-factor estimate $\hat\beta_{U,0}$. Vertical bars show $\pm 1.96$ within-vintage standard errors of the weighted fund mean for vintages with $n_v\ge 2$ funds; open circles mark singleton vintages ($n_v=1$, entering L2 only). Persistent multi-vintage deviations (notably VC 1993--1997) visually separate vintage-level cohort realizations from within-vintage idiosyncratic dispersion.}
\end{figure}
